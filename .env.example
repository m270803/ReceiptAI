PORT=8082
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/raseed
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
OTP_SECRET=replace-with-a-separate-long-random-secret
DEV_OTP_CODE=1234
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Set for a physical device to the backend host's LAN address, for example:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8082
